{
  "name": "xhs-app",
  "version": "0.9.7",
  "private": true,
  "description": "xhsPilot - 小红书自运营系统",
  "main": "./out/main/index.js",
  "author": "TBD",
  "scripts": {
    "build:go": "go build -C ../xiaohongshu-mcp -o ../app/resources/bin/xiaohongshu-mcp .",
    "build:go:win": "cd ../xiaohongshu-mcp && GOOS=windows GOARCH=amd64 go build -o ../app/resources/bin/xiaohongshu-mcp.exe .",
    "predev": "npm run build:go",
    "prebuild": "npm run build:go",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:win": "npm run build:go:win && electron-vite build && electron-builder --win --publish never",
    "build:win:docker": "npm run build:go:win && electron-vite build && docker run --rm -v \"$(pwd)\":/project -w /project electronuserland/builder:wine /bin/bash -c 'npm install --no-audit --prefer-offline 2>&1 | tail -3 && ./node_modules/.bin/electron-builder --win --x64 --publish never'",
    "typecheck": "./node_modules/.bin/tsc --noEmit -p tsconfig.node.json && ./node_modules/.bin/tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
    "better-sqlite3": "^12.10.0",
    "electron-log": "^5.2.0",
    "node-machine-id": "^1.1.12",
    "openai": "^6.37.0",
    "qrcode.react": "^4.2.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^38.8.6",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.2",
    "zustand": "^4.5.5"
  },
  "build": {
    "appId": "top.doublel.xhspilot",
    "productName": "xhsPilot",
    "copyright": "Copyright © 2026",
    "artifactName": "xhspilot-${version}-${arch}.${ext}",
    "afterPack": "scripts/ad-hoc-sign.cjs",
    "directories": {
      "output": "release/${version}"
    },
    "asar": true,
    "asarUnpack": [
      "resources/bin/**/*",
      "**/*.node"
    ],
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "artifactName": "xhspilot-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "writeUpdateInfo": true,
      "sign": false,
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 450,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 150,
          "y": 360,
          "type": "link",
          "path": "/System/Applications/Utilities/Terminal.app",
          "name": "打开终端"
        },
        {
          "x": 450,
          "y": 360,
          "type": "file",
          "path": "dmg-resources/无法正常打开请看我.txt",
          "name": "无法正常打开请看我.txt"
        }
      ],
      "window": {
        "width": 600,
        "height": 480
      }
    },
    "publish": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "xhspilot-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
